PROXY_API_KEY=openrouter_proxy_injector_api_key

# Preferred key list. OPENROUTER_KEYS still works as a fallback alias.
# Format: key or key:daily_limit — comma-separated
UPSTREAM_KEYS=upstream_api_key1:50,upstream_api_key2:50
# OPENROUTER_KEYS=openrouter_api_key1,openrouter_api_key2,openrouter_api_key3

# Default: OpenRouter. For ModelScope use:
# UPSTREAM_BASE_URL=https://api-inference.modelscope.cn/v1
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter free quota resets at UTC midnight. ModelScope resets at Asia/Shanghai midnight.
TIMEZONE=UTC

# Optional overrides (auto-detected from UPSTREAM_BASE_URL if omitted):
# OpenRouter defaults: DEFAULT_KEY_DAILY_LIMIT=50, KEY_MIN_INTERVAL_SECONDS=3
# Other upstreams:     DEFAULT_KEY_DAILY_LIMIT=125, KEY_MIN_INTERVAL_SECONDS=0
# DEFAULT_KEY_DAILY_LIMIT=50
# KEY_MIN_INTERVAL_SECONDS=3

UVICORN_LOG_LEVEL=info
APP_PORT=8000
