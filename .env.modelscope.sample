# Copy to .env.modelscope and fill in keys. Run a second instance so OpenRouter .env is untouched:
#   set DOTENV=.env.modelscope
#   Or: copy values into a dedicated env and start on another port (e.g. 10000)

PROXY_API_KEY=modelscope_proxy_api_key

UPSTREAM_BASE_URL=https://api-inference.modelscope.cn/v1
UPSTREAM_KEYS=ms-your-key-1:125,ms-your-key-2:125

# ModelScope free quota resets at midnight China time
TIMEZONE=Asia/Shanghai
DEFAULT_KEY_DAILY_LIMIT=125
KEY_MIN_INTERVAL_SECONDS=0

UVICORN_LOG_LEVEL=info
APP_PORT=10001
