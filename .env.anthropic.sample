PROXY_API_KEY=change_me_proxy_auth_key

# Official Anthropic API keys (sk-ant-...), comma-separated; optional :daily_limit
# Example: sk-ant-api03-xxxx:500,sk-ant-api03-yyyy:500
UPSTREAM_KEYS=sk-ant-api03-xxxx:500,sk-ant-api03-yyyy:500

# Official Anthropic (no /v1 suffix; Claude Agent calls /v1/messages)
UPSTREAM_BASE_URL=https://api.anthropic.com

TIMEZONE=UTC
DEFAULT_KEY_DAILY_LIMIT=500
KEY_MIN_INTERVAL_SECONDS=0
UVICORN_LOG_LEVEL=info
APP_PORT=10002
